{
  "outputDirectory": "dist/school-gate-web/browser",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://schoolgate-api-nine.vercel.app/api/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "https://schoolgate-api-nine.vercel.app/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
